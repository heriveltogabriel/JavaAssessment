serverUrl=https://DASHBOARD_PUBLIC_URL
hostId=REPLACE_WITH_STABLE_UNIQUE_HOST_ID
agentToken=REPLACE_WITH_PER_HOST_AGENT_TOKEN
spoolDirectory=/opt/java-assessment-collector/collector-spool
# Optional integration; leave unset unless explicitly configured.
# snapshotRoot=/absolute/path/to/approved/snapshots
# hostname is optional; the local hostname is discovered when omitted.
# hostname=server.example.com

# Registration normally generates this file automatically.
# Remote origins require HTTPS with the package's verified TLS provider.
# tlsProvider=BCJSSE
# tlsCaFile=/absolute/path/java-assessment/conf/ca.pem

# Optional passive Spring datasource prefixes (default: spring.datasource only).
# spring.datasourcePrefixes=app.datasource.orders,app.datasource.audit
# Optional application-provided JDBC metadata; disabled unless explicitly mapped.
# spring.integration.orders.applicationPath=/opt/orders/orders.jar
# spring.integration.orders.file=/var/lib/orders-assessment/report.json
# See docs/SPRING_DISCOVERY.md and docs/SPRING_INTEGRATION.md.
